<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
    <div id="home">
        <div id="page1">
            <%- include("includes/header.ejs") %>
            <div class="heading">
                <p class="hero-sub">Discover unique stays around the world</p>
                <h1 style="color:white; font-size: 4.5rem; font-weight: 600; line-height: 1.1; font-family: 'Cormorant Garamond', serif; letter-spacing: 0.02em;">Find Your <br> Perfect Stay</h1>
                <div class="hero-stats">
                    <div class="stat"><span>10K+</span><p>Properties</p></div>
                    <div class="stat"><span>150+</span><p>Cities</p></div>
                    <div class="stat"><span>50K+</span><p>Happy Guests</p></div>
                </div>
            </div>
            <div class="scroll-hint">
                <div class="scroll-arrow">&#8595;</div>
            </div>
        </div>

        <div id="page2">
            <section class="carousel-section">
                <div class="section-heading">Where next, <em>traveller?</em></div>
                <div class="stage" id="stage"></div>
                <div class="fc-controls">
                    <button class="fc-btn" onclick="move(-1)">&#8592;</button>
                    <div class="fc-dots" id="dots"></div>
                    <button class="fc-btn" onclick="move(1)">&#8594;</button>
                </div>
                <div style="text-align:center; margin-top: 2rem;">
                    <a href="/listings" class="btn-view-all">View all listings →</a>
                </div>
            </section>

            <script>
                const places = [
                    { city: "Miami",      country: "United States", img: "./miami.avif" },
                    { city: "Mykonos",    country: "Greece",        img: "./greece.avif" },
                    { city: "Cancun",     country: "Mexico",        img: "./para.avif" },
                    { city: "Aspen",      country: "United States", img: "./mountain.avif" },
                    { city: "Amalfi",     country: "Italy",         img: "./villa.avif" },
                    { city: "Marrakech",  country: "Morocco",       img: "./safari.avif" },
                    { city: "Queenstown", country: "New Zealand",   img: "./cottage.avif" },
                ];

                const positions = [
                    { x: -780, rotY:  50, scale: 0.50, z: -280, opacity: 0   },
                    { x: -500, rotY:  38, scale: 0.68, z: -140, opacity: 0.6 },
                    { x: -250, rotY:  22, scale: 0.84, z: -55,  opacity: 0.9 },
                    { x:    0, rotY:   0, scale: 1,    z:   0,  opacity: 1   },
                    { x:  250, rotY: -22, scale: 0.84, z: -55,  opacity: 0.9 },
                    { x:  500, rotY: -38, scale: 0.68, z: -140, opacity: 0.6 },
                    { x:  780, rotY: -50, scale: 0.50, z: -280, opacity: 0   },
                ];

                let current = 3;
                const total = places.length;

                function getPos(cardIdx) {
                    let diff = cardIdx - current;
                    if (diff < -3) diff += total;
                    if (diff >  3) diff -= total;
                    const idx = diff + 3;
                    if (idx < 0 || idx > 6) return null;
                    return positions[idx];
                }

                function render() {
                    document.querySelectorAll('.fc-card').forEach((card, i) => {
                        const p = getPos(i);
                        if (!p) { card.style.opacity = 0; card.style.pointerEvents = 'none'; return; }
                        card.style.transform = `translateX(${p.x}px) translateZ(${p.z}px) rotateY(${p.rotY}deg) scale(${p.scale})`;
                        card.style.opacity = p.opacity;
                        card.style.zIndex  = Math.round(p.scale * 10);
                        card.style.pointerEvents = p.opacity > 0.5 ? 'auto' : 'none';
                    });
                    document.querySelectorAll('.fc-dot').forEach((d, i) => {
                        d.classList.toggle('active', i === current);
                    });
                }

                function move(dir) {
                    current = (current + dir + total) % total;
                    render();
                }

                // build DOM
                const stage = document.getElementById('stage');
                const dotsEl = document.getElementById('dots');

                places.forEach((p, i) => {
                    const card = document.createElement('div');
                    card.className = 'fc-card';
                    card.innerHTML = `
                        <img src="${p.img}" alt="${p.city}" loading="lazy"/>
                        <div class="fc-info">
                            <div class="fc-city">${p.city}</div>
                            <div class="fc-sub">${p.country}</div>
                        </div>`;
                    card.onclick = () => { current = i; render(); };
                    stage.appendChild(card);

                    const dot = document.createElement('div');
                    dot.className = 'fc-dot';
                    dot.onclick = () => { current = i; render(); };
                    dotsEl.appendChild(dot);
                });

                // keyboard support
                document.addEventListener('keydown', e => {
                    if (e.key === 'ArrowLeft')  move(-1);
                    if (e.key === 'ArrowRight') move(1);
                });

                render(); // ← render first

                // mouse hover to shift — AFTER render()
                let hoverTimer = null;
                let lastPercent = 0.5;

                stage.addEventListener('mousemove', (e) => {
                    const rect = stage.getBoundingClientRect();
                    lastPercent = (e.clientX - rect.left) / rect.width;

                    if (lastPercent > 0.7) {
                        stage.style.cursor = 'e-resize';
                    } else if (lastPercent < 0.3) {
                        stage.style.cursor = 'w-resize';
                    } else {
                        stage.style.cursor = 'default';
                    }

                    clearTimeout(hoverTimer);
                    hoverTimer = setTimeout(() => {
                        if (lastPercent > 0.7) move(1);
                        else if (lastPercent < 0.3) move(-1);
                    }, 800);
                });

                stage.addEventListener('mouseleave', () => {
                    clearTimeout(hoverTimer);
                    stage.style.cursor = 'default';
                });
            </script>
        </div>
    </div>

    <%- include("includes/contact.ejs") %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="/script.js"></script>
</body>
</html>