<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
   <style>.rn {
    position: relative;
    
}

.rn::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0%;
    height: 2px;
    background: black !important;
    transition: width 0.3s ease;
}

.rn:hover::after {
    width: 100%;
}</style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
 <div class="nav">
    <div class="leftnav">
        <a href="/"><h1 style="color: #ec2c62; font-weight: 700; letter-spacing: -0.5px;">WanderStay</h1></a>
    </div>
    <div class="rightnav">
        <div class="rn"><a href="/listings"><h4 style="color: black;">Listings</h4></a></div>
        <div class="rn"><a href="/host"><h4 style="color: black;">Host</h4></a></div>
        <div class="rn"><a href="#contact"><h4 style="color: black;">Contact</h4></a></div>
        <div class="rn"><a href="/login"><h4 style="color: black;">Login</h4></a></div>
        <div class="rn"><a href="/signup"><h4 style="color: black;">Signup</h4></a></div>
    </div>
</div>
<hr style="margin: 0; border: none; border-top: 1px solid #ebebeb !important;">

    <h1 style="margin-top: 50px;margin-left: 55px;margin-bottom: 30px;">
        All Listings
    </h1>
    <div class="listings-container ">
    <% for(let listing of listings){ %>
        <div class="list">
        <a href="/listings/<%=listing._id%>"><img src="<%= listing.image %>"></a>
        <h3><%=listing.title %></h3>
        <p>₹<%=listing.price %>/night</p>
        </div>
    <% } %>
    </div>
    <%-include("includes/contact.ejs")%>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="/script.js"></script>
    
</body>
</html>