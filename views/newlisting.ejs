<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Listing – WanderStay</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/style.css">
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f7f7f7; min-height: 100vh; }
        input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px #fafafa inset !important;
    -webkit-text-fill-color: #111 !important;
    transition: background-color 5000s ease-in-out 0s;
}
        .page { max-width: 680px; margin: 3rem auto; padding: 0 1.5rem 4rem; }
        .page-eyebrow { font-size: 0.78rem; font-weight: 600; color: #ec2c62; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.5rem; }
        .page-title { font-size: 1.9rem; font-weight: 700; color: #111; margin-bottom: 0.4rem; }
        .page-sub { font-size: 0.95rem; color: #888; margin-bottom: 2.5rem; }

        .form-card { background: #fff; border-radius: 18px; border: 1px solid #ebebeb; box-shadow: 0 4px 24px rgba(0,0,0,0.07); padding: 2rem 2.5rem 2.5rem; }

        .form-section-label { font-size: 0.72rem; font-weight: 700; color: #aaa; text-transform: uppercase; letter-spacing: 0.1em; margin: 1.8rem 0 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #f0f0f0; }
        .form-section-label:first-child { margin-top: 0; }

        .form-group { margin-bottom: 1.2rem; }
        .form-group label { display: block; font-size: 0.85rem; font-weight: 600; color: #333; margin-bottom: 0.45rem; }
        .form-group label .required { color: #ec2c62; margin-left: 2px; }

        .form-group input, .form-group textarea {
            width: 100%; padding: 0.7rem 1rem; border: 1.5px solid #e0e0e0;
            border-radius: 10px; font-size: 0.92rem; font-family: inherit;
            color: #111; background: #fafafa; transition: border-color 0.2s, box-shadow 0.2s;
            outline: none; resize: vertical;
        }
        .form-group input:focus, .form-group textarea:focus {
            border-color: #ec2c62; background: #fff;
            box-shadow: 0 0 0 3px rgba(236,44,98,0.08);
        }
        .form-group input::placeholder, .form-group textarea::placeholder { color: #bbb; }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

        
        .file-upload-area:hover { border-color: #ec2c62; background: #fff5f8; }
       
        .upload-icon { font-size: 2rem; color: #ddd; margin-bottom: 0.5rem; }
        .upload-text { font-size: 0.88rem; color: #888; }
        .upload-text span { color: #ec2c62; font-weight: 600; }

        .input-prefix-wrap { position: relative; }
        .input-prefix-wrap .prefix { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); font-weight: 600; color: #555; font-size: 0.92rem; pointer-events: none; }
        .input-prefix-wrap input { padding-left: 2rem; }

        .btn-submit { width: 100%; margin-top: 2rem; padding: 0.9rem; background: linear-gradient(135deg, #ec2c62, #d41f52); color: #fff; border: none; border-radius: 12px; font-size: 1rem; font-weight: 700; font-family: inherit; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 4px 18px rgba(236,44,98,0.35); transition: transform 0.15s, box-shadow 0.2s; }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(236,44,98,0.45); }

        .form-footer-note { text-align: center; font-size: 0.8rem; color: #bbb; margin-top: 1rem; }
    </style>
</head>
<body>

    <!-- your existing nav here -->

    <div class="page">
        <div class="page-eyebrow">Host Dashboard</div>
        <h1 class="page-title">Add a new listing</h1>
        <p class="page-sub">Fill in the details below to publish your property.</p>

        <div class="form-card">
            <form action="/savenewlisting" method="POST" enctype="multipart/form-data">

                <div class="form-section-label">Property details</div>

                <div class="form-group">
                    <label>Title <span class="required">*</span></label>
                    <input type="text" name="title" placeholder="e.g. Luxury Penthouse with City Views" required>
                </div>

                <div class="form-group">
                    <label>Description<span class="required">*</span></label>
                    <textarea name="description" rows="4" placeholder="Describe your property..." required></textarea>
                </div>

                <div class="form-section-label">Location & Pricing</div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Country <span class="required">*</span></label>
                        <input type="text" name="country" placeholder="e.g. India" required>
                    </div>
                    <div class="form-group">
                        <label>Location <span class="required">*</span></label>
                        <input type="text" name="location" placeholder="e.g. Mumbai" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>Price per night <span class="required">*</span></label>
                    <div class="input-prefix-wrap">
                        <span class="prefix">₹</span>
                        <input type="number" name="price" placeholder="0" required>
                    </div>
                </div>

                <div class="form-section-label">Property image</div>

                <div class="form-group">
                    <div class="file-upload-area">
                        <label for="inputImage" class="form-label">Image Link<span class="required">*</span></label>
    <input type="file" class="form-control" id="inputImage"  name="image" required>
                        
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="bi bi-house-check-fill"></i>
                    Publish Listing
                </button>
                <p class="form-footer-note">Your listing will be visible to guests immediately after publishing.</p>

            </form>
        </div>
    </div>

</body>
</html>