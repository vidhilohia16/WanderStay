<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
   <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
    <div id="home">

    <!-- <%-include("includes/header.ejs")%> -->
     <div id="page1">

     <!-- <img class ="front" src="./Gemini_Generated_Image_yyjgwyyyjgwyyyjg.png"> -->
     <div class="nav">
        <div class="leftnav">
            <a href="/"><h1>WanderStay</h1></a>
        </div>
        <div class="rightnav">
            <div class="rn">
                <a href="/listings"><h4>Listings</h4></a>
            </div>
            <div class="rn">
                <a href="/host"><h4>Host</h4></a>
            </div>
            <div class="rn">
                <a href="/contact"><h4>Contact</h4></a>
            </div>
            <div class="rn">
                <h4>Login</h4>
            </div>
            
        </div>
     </div>
     <div class="login">
        <% if (locals.error && locals.error.length > 0) { %>
    <div class="flash-msg" style="background: linear-gradient(135deg, #dc2626, #ef4444); box-shadow: 0 4px 20px rgba(239,68,68,0.4);margin-top: 0px;">
        ✗ <%= locals.error[0] %>
    </div>
<% } %>
    <div class="login-inner">
        <h2 class="login-title">Create Account</h2>
        <p class="login-sub">Join WanderStay and start exploring</p>

        <form method="post" action="/">

            <div class="login-field">
                <label>Email Address</label>
                <input type="email" name="email" class="login-input" placeholder="name@example.com" autocomplete="new-password" required>
            </div>
            <div class="login-field">
                <label>Username</label>
                <input type="text" name="username" class="login-input" placeholder="Name123"  autocomplete="new-password" required>
            </div>
            <div class="login-field">
                <label>Password</label>
                <input type="password" name="password" class="login-input" placeholder="••••••••"  autocomplete="new-password" required>
            </div>
            <button type="submit" class="login-btn">Create Account</button>
            <p class="login-footer">Already have an account? <a href="/login">Sign in</a></p>
        </form>
    </div>
</div>
    
     <div class="heading">
    <p class="hero-sub">Discover unique stays around the world</p>
    <h1 style="color:white; font-size: 4.5rem; font-weight: 600; line-height: 1.1; font-family: 'Cormorant Garamond', serif; letter-spacing: 0.02em;">Find Your <br> Perfect Stay</h1>
    <div class="hero-stats">
        <div class="stat"><span>10K+</span><p>Properties</p></div>
        <div class="stat"><span>150+</span><p>Cities</p></div>
        <div class="stat"><span>50K+</span><p>Happy Guests</p></div>
    </div>
</div>

     </div>
     </div>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="/script.js"></script>
     </body>
     </html>
